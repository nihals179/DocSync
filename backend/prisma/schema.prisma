generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlanCatalog {
  id                String   @id
  name              String
  priceMonthlyCents Int
  displayPrice      String
  featureBasicEditor             Boolean  @default(false)
  featureAiAssistant             Boolean  @default(false)
  featureGrammarChecker          Boolean  @default(false)
  featurePrioritySupport         Boolean  @default(false)
  featureCommunitySupport        Boolean  @default(false)
  featureSsoSaml                 Boolean  @default(false)
  featureCustomRolesRbac         Boolean  @default(false)
  featureAuditLogs               Boolean  @default(false)
  featureSlaDedicatedSupport     Boolean  @default(false)
  featureOnPremiseOption         Boolean  @default(false)
  featureSelfHostedDeployment    Boolean  @default(false)
  featurePrivateNetworkOnly      Boolean  @default(false)
  featureCustomComplianceControls Boolean @default(false)
  featureDedicatedSuccessTeam    Boolean  @default(false)
  limitSeats                     Int     @default(0)
  limitStorageBytes              BigInt  @default(0)
  limitAiRequestsPerMonth        Int     @default(0)
  limitCollaborators             Int     @default(0)
  limitDocuments                 Int?
  limitDocumentUpdatesPerMonth   Int?
  limitVersionHistoryDays        Int?
  limitGrammarAccessDays         Int?
  limitAiAccessDays              Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenantBillings    tenantBilling[]

  @@map("plan_catalog")
}

model User {
  id                    String   @id
  name                  String
  email                 String   @unique
  passwordHash          String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  accountType           String   @default("individual")
  isSubscribed          Boolean  @default(false)
  emailVerified         Boolean  @default(false)
  failedLoginAttempts   Int      @default(0)
  lockoutUntil          DateTime?
  lastLoginAt           DateTime?
  role                  String   @default("user")
  twoFactorEnabled      Boolean  @default(false)
  twoFactorSecret       String?
  twoFactorTempSecret   String?
  currentTenantId       String?
  currentTenant         Tenant?            @relation("UserCurrentTenant", fields: [currentTenantId], references: [id])
  tenantMemberships    tenantMembership[] @relation("UserMemberships")
  userBilling           UserBilling?
  userUsage             UserUsage[]
  authSessions          AuthSession[]
  invitesSent           tenantsInvite[]    @relation("InvitedByUser")
  invitesAccepted       tenantsInvite[]    @relation("AcceptedByUser")

  @@map("users")
}

model Tenant {
  id          String   @id
  name        String
  ownerUserId String
  ownerEmail  String?
  security    Json?
  memberships tenantMembership[]
  currentUsers User[] @relation("UserCurrentTenant")
  billing      tenantBilling?
  usage        TenantsUsage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tenants")
}

model tenantBilling {
  tenantId          String   @id
  planId            String
  status            String
  purchasedSeats    Int
  trialEndsAt       DateTime?
  trialUsed         Boolean  @default(false)
  subscriptionId    String?
  customerId        String?
  currentPeriodEndAt DateTime?
  graceEndsAt       DateTime?
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  planCatalog       PlanCatalog @relation(fields: [planId], references: [id])

  @@index([planId])
  @@map("tenant_billing")
}

model tenantMembership {
  id           String   @id
  tenantId     String
  userId       String?
  email        String?
  billingAdmin Boolean  @default(false)
  status       String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  user         User?    @relation("UserMemberships", fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, userId])
  @@unique([tenantId, email])
  @@index([email])
  @@map("tenant_memberships")
}

model Profile {
  id                             String   @id
  role                           String   @unique
  canAccessAdminBoard            Boolean  @default(false)
  canReviewSecurityAudit         Boolean  @default(false)
  canManageGlobalSettings        Boolean  @default(false)
  canManageMembers               Boolean  @default(false)
  canManageMemberBillingAdmin    Boolean  @default(false)
  canManageTenantBilling         Boolean  @default(false)
  canManageWorkspacesDocuments   Boolean  @default(false)
  canReadTenantResources         Boolean  @default(false)
  canUseAiGrammarByPlan          Boolean  @default(false)
  canManageBillingSettings       Boolean  @default(false)
  canViewInvoicesSubscription    Boolean  @default(false)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  @@map("profiles")
}

model Template {
  id          String   @id
  title       String
  description String
  icon        String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("templates")
}

model tenantsInvite {
  id              String   @id
  token           String   @unique
  tenantId        String
  email           String
  billingAdmin    Boolean  @default(false)
  status          String
  invitedByUserId String?
  invitedByUser   User?    @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptedByUser  User?    @relation("AcceptedByUser", fields: [email], references: [email], onDelete: Cascade)
  inviteLink      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime
  acceptedAt      DateTime?

  @@map("tenant_invites")
}

model AuthSession {
  id               String   @id
  userId           String
  refreshTokenHash String
  csrfToken        String
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime
  expiresAt        DateTime
  revokedAt        DateTime?
  remember         Boolean  @default(false)
  userAgent        String
  ipAddress        String
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId         String?

  @@map("auth_sessions")
}

model Invoice {
  id             String   @id
  tenantId       String?
  provider       String
  invoiceNumber  String?
  amountCents    Int
  currency       String
  status         String
  issuedAt       DateTime
  dueAt          DateTime?
  paidAt         DateTime?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("invoices")
}

model UserBilling {
  userId             String   @id
  email              String?  @unique
  planId             String
  status             String
  trialEndsAt        DateTime?
  trialUsed          Boolean  @default(false)
  subscriptionId     String?
  customerId         String?
  currentPeriodEndAt DateTime?
  graceEndsAt        DateTime?
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id])

  @@map("user_billing")
}

model TenantsUsage {
  tenantId        String
  monthKey        String
  aiRequests      Int      @default(0)
  documentUpdates Int      @default(0)
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, monthKey])
  @@map("tenant_usage")
}


model UserUsage {
  userId          String
  monthKey        String
  aiRequests      Int      @default(0)
  documentUpdates Int      @default(0)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
  tenantId        String? 

  @@id([userId, monthKey])
  @@map("user_usage")
}

model WebhookJob {
  id            String   @id
  eventId       String
  provider      String
  type          String
  payload       Json
  status        String
  attempts      Int      @default(0)
  maxAttempts   Int      @default(8)
  nextAttemptAt DateTime
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([eventId])
  @@map("webhook_jobs")
}

model ProcessedWebhookEvent {
  eventId     String   @id
  provider    String
  processedAt DateTime @default(now())

  @@map("processed_webhook_events")
}

model AuthToken {
  id        String   @id
  userId    String
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("auth_tokens")
}

model AppConfig {
  scope     String   @default("auth")
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([scope, key])
  @@map("app_config")
}

model AuditLog {
  id             String   @id
  userId         String?
  tenantId        String?
  action         String
  status         String
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
  @@map("audit_logs")
}

model Document {
  id             String   @id
  userId         String
  tenantId       String?
  workspaceId    String?
  parentId       String?
  sortOrder      Int      @default(0)
  title          String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Deleting a parent goes through the API, which removes the whole subtree with its
  // comments and versions; the database refuses deletes that would orphan children.
  parent         Document?  @relation("DocumentTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  children       Document[] @relation("DocumentTree")

  @@index([userId])
  @@index([tenantId])
  @@index([tenantId, workspaceId, parentId, sortOrder])
  @@map("documents")
}

model Comment {
  id        String   @id
  docId     String
  userId    String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String?  @map("tenantid")

  @@index([docId])
  @@map("comments")
}

model Version {
  id        String   @id
  docId     String
  userId    String?
  title     String?
  content   String
  savedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  tenantId   String? 
  
  @@index([docId])
  @@map("versions")
}

model Todo {
  id             String   @id
  workspaceId    String?
  tenantId       String?
  userId         String
  title          String
  completed      Boolean  @default(false)
  dueAt          DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([workspaceId])
  @@index([tenantId])
  @@map("todos")
}

model Workspace {
  id             String   @id
  name           String
  ownerId        String
  memberIds      Json?
  tenantId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerId])
  @@index([tenantId])
  @@map("workspaces")
}
