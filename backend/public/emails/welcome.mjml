<mjml>
  <mj-head>
    <mj-title>Welcome to DocSync</mj-title>
    <mj-preview>Welcome to DocSync! Start collaborating with your team.</mj-preview>
    <mj-style>
      body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f9fafb">
    <mj-section background-color="#ffffff">
      <mj-column>
        <mj-text align="center" font-size="24px" font-weight="bold" color="#2563eb" padding="20px 0">
          DocSync
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding-top="0">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#1f2937" padding-bottom="10px">
          Welcome to DocSync!
        </mj-text>

        <mj-text color="#6b7280" padding-bottom="15px">
          Hi {{userName}},
        </mj-text>

        <mj-text color="#6b7280">
          Thank you for joining DocSync. We're thrilled to have you on board!
        </mj-text>

        <mj-text color="#6b7280" padding-top="20px">
          DocSync makes document collaboration seamless and secure. Start exploring now and discover how easy it is to:
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#f3f4f6">
      <mj-column>
        <mj-text color="#6b7280" padding="15px"><strong>✓</strong> Create and manage documents in real-time</mj-text>
        <mj-text color="#6b7280" padding="5px"><strong>✓</strong> Collaborate with your team instantly</mj-text>
        <mj-text color="#6b7280" padding="5px"><strong>✓</strong> Keep version history and track changes</mj-text>
        <mj-text color="#6b7280" padding="5px"><strong>✓</strong> Secure your documents with enterprise-grade protection</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff">
      <mj-column>
        <mj-text color="#6b7280" padding-top="20px">
          You can now start creating and managing your documents right away.
        </mj-text>

        <mj-text color="#6b7280" padding-bottom="20px">
          If you have any questions or need help getting started, feel free to reach out to our support team.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding-top="0" border-top="2px solid #f0f0f0">
      <mj-column>
        <mj-text align="center" color="#9ca3af" font-size="12px" padding="20px 0">
          &copy; 2026 DocSync. All rights reserved.<br/>
          This is an automated message. Please do not reply to this email.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
