<mjml>
  <mj-head>
    <mj-title>Verify Your Email</mj-title>
    <mj-preview>Complete your DocSync registration by verifying your email address.</mj-preview>
    <mj-style>
      body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f9fafb">
    <mj-section background-color="#ffffff">
      <mj-column>
        <mj-text align="center" font-size="24px" font-weight="bold" color="#2563eb" padding="20px 0">
          DocSync
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding-top="0">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#1f2937" padding-bottom="10px">
          Verify Your Email Address
        </mj-text>

        <mj-text color="#6b7280">
          Hi {{userName}},
        </mj-text>

        <mj-text color="#6b7280" padding-bottom="20px">
          Thank you for signing up for DocSync. To complete your registration, please verify your email address by clicking the button below:
        </mj-text>

        <mj-button font-size="16px" background-color="#10b981" href="{{verificationLink}}" padding="20px 0">
          Verify Email Address
        </mj-button>

        <mj-text align="center" color="#9ca3af" font-size="12px" padding="20px 0">
          Or copy and paste this link in your browser:
        </mj-text>

        <mj-text color="#2563eb" font-size="12px" padding="10px" background-color="#eff6ff" font-family="'Courier New', monospace">
          {{verificationLink}}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#fef3c7" padding="12px">
      <mj-column>
        <mj-text color="#78350f" font-size="13px">
          <strong>⏱️ Note:</strong> This link expires in 24 hours. If you didn't create this account, you can safely ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff">
      <mj-column>
        <mj-text color="#6b7280">
          If you're having trouble clicking the button, copy and paste the link above into your browser.
        </mj-text>

        <mj-text color="#6b7280">
          Once verified, you'll have full access to all DocSync features.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding-top="0" border-top="2px solid #f0f0f0">
      <mj-column>
        <mj-text align="center" color="#9ca3af" font-size="12px" padding="20px 0">
          &copy; 2026 DocSync. All rights reserved.<br/>
          This is an automated message. Please do not reply to this email.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
