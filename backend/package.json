{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "NODE_ENV=test node --test",
    "start": "node index.js",
    "dev": "node ./node_modules/nodemon/bin/nodemon.js --inspect=0 index.js",
    "dev:debug": "node ./node_modules/nodemon/bin/nodemon.js --inspect=0 index.js",
    "redis:start": "docker run -d --name docsync-redis -p 6379:6379 redis:7-alpine || docker start docsync-redis",
    "redis:stop": "docker stop docsync-redis || true",
    "redis:rm": "docker rm -f docsync-redis || true",
    "redis:logs": "docker logs -f docsync-redis",
    "redis:ping": "node scripts/redis-health.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed:admin": "node src/db/seed-admin.js",
    "db:seed:plans": "node src/db/seed-plan-catalog.js",
    "db:seed:templates": "node src/db/seed-templates.js",
    "db:seed:test-users": "node src/db/seed-test-users.js",
    "db:seed:all": "npm run db:seed:admin && npm run db:seed:plans && npm run db:seed:templates && npm run db:seed:test-users",
    "db:import:audit-logs": "node src/db/import-audit-logs.js",
    "db:backfill:workspaces": "node src/db/backfill-workspaces.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "jsonwebtoken": "^9.0.3",
    "nodemon": "^3.1.14",
    "otplib": "^13.4.0",
    "prisma": "^6.16.2",
    "qrcode": "^1.5.4",
    "redis": "^5.12.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
