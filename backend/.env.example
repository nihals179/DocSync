# Backend configuration
# Environment switch used when DATABASE_URL is not set.
# Allowed values: DEV, ITT, UAT, PROD
DOCSYNC_ENV="DEV"

# Optional direct DB/Redis URL overrides.
# If set, these override DOCSYNC_ENV mapping.
DEV.DATABASE_URL="postgresql://docsync@localhost:5432/docsync_prod?schema=public"
DEV.REDIS_URL="redis://127.0.0.1:6379"
DATABASE_URL="postgresql://docsync@localhost:5432/docsync_prod?schema=public"
REDIS_URL="redis://127.0.0.1:6379"
# Optional: auth config cache TTL in Redis seconds.
# Set 0 (default) for no expiry so cache survives backend restarts.
REDIS_AUTH_CONFIG_TTL_SECONDS="0"
PGSSLMODE="disable"

# Frontend origin used for verification and reset links.
FRONTEND_URL="http://localhost:5173"
